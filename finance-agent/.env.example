##############################################################################
# finance-agent（财务审批）环境变量模板
#
# 【目的】报销链路 + 制度 RAG + 角色登录；端口与前两个项目完全隔离。
# 【易错点】
# 1. API=8003 / PG=5434 / Redis=6381 —— 抄成 8001/5432 会打到 rag-agent。
# 2. 演示账号在代码 services/auth.py 的 DEMO_ACCOUNTS，不在本文件。
# 3. 发票 OCR 首次会下模型；务必设 HF_ENDPOINT，否则可能很慢/失败。
# 4. 改 AUTO_APPROVE_LIMIT 影响「自动过」还是「进待审批」。
##############################################################################

# --- App ---
APP_NAME=finance-agent
APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8003

# --- LLM ---
LLM_API_KEY=sk-your-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 财务场景要稳，温度建议更低
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TOP_P=1.0

# --- Embedding（制度库 RAG）---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMS=512
HF_ENDPOINT=https://hf-mirror.com
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# --- PostgreSQL / Redis ---
DATABASE_URL=postgresql+asyncpg://fin:fin@127.0.0.1:5434/finance_agent
DATABASE_URL_SYNC=postgresql+psycopg://fin:fin@127.0.0.1:5434/finance_agent
REDIS_URL=redis://127.0.0.1:6381/0
# 登录 token 与会话历史共用 TTL
SESSION_TTL_SECONDS=3600

# --- 制度 RAG ---
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=4
RAG_MAX_DISTANCE=0.55
COLLECTION_NAME=finance_policy
MAX_PDF_BYTES=10485760
# 发票附件大小上限（略大于制度 PDF 亦可）
MAX_RECEIPT_BYTES=12582912
# 票据原件落盘目录（相对项目根）
RECEIPT_STORAGE_DIR=data/receipts

# --- 报销标准（元）与审批阈值 ---
MEAL_LIMIT_PER_DAY=80
TRAVEL_HOTEL_LIMIT=450
TRANSPORT_TAXI_LIMIT=200
# 低于该金额且低风险 → auto_approved；否则 pending_approval 等管理员
AUTO_APPROVE_LIMIT=500
DEFAULT_DEPT_BUDGET=20000
COMPANY_NAME=示例科技
# true=模拟 ERP 生成凭证号；false 需自己实现真实对接（否则会报错）
ERP_MOCK=true
