##############################################################################
# rag-agent 环境变量模板
#
# 【目的】把密钥、端口、模型名从代码里拆出来，换机器/换模型只改本文件。
# 【用法】复制为同目录 `.env` 再改真实值：  copy .env.example .env
# 【易错点】
# 1. 改完 `.env` 必须重启 uvicorn；config 用了 lru_cache，热改不生效。
# 2. 端口要和 docker-compose 一致（本项目 PG=5432 Redis=6379 API=8001）。
# 3. 与 cs-agent / finance-agent 同时跑时，千万别共用同一端口。
# 4. EMBEDDING_DIMS 改了要清空向量表，否则维度不匹配会报错或检索异常。
##############################################################################

# --- App ---
APP_NAME=rag-agent
# dev 时 uvicorn 可开 reload；prod 建议关
APP_ENV=dev
# 0.0.0.0 = 本机所有网卡可访问；只想本机访问可改 127.0.0.1
API_HOST=0.0.0.0
# 易错：默认曾用 8000，若本机已有旧进程，请求会打到旧服务 → 改成 8001
API_PORT=8001

# --- LLM（OpenAI 兼容协议：DeepSeek / 自建网关都行）---
# 易错：没填 key 时 /chat 会 400；不要把真实 key 提交到 git
LLM_API_KEY=sk-your-key
# 必须带 /v1（多数 OpenAI 兼容服务如此）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 温度越高越发散；知识库问答建议偏低（0.1~0.3）
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TOP_P=1.0

# --- Embedding 向量模型 ---
# openai = 调远程 embedding 接口；local = 本机 FastEmbed（网关没有 embedding 模型组时用）
# 易错：远程返回 403 “model group” → 改 EMBEDDING_PROVIDER=local
EMBEDDING_PROVIDER=local
# FastEmbed 模型名必须精确；错写成 BAAI/base-zh-v1.5 会下载失败
# 代码里有别名纠错，但最好一开始就写对：BAAI/bge-small-zh-v1.5
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 必须与模型真实维度一致（bge-small-zh-v1.5 = 512）
EMBEDDING_DIMS=512
# 国内下载 HuggingFace 模型用镜像；不设可能卡住或超时
HF_ENDPOINT=https://hf-mirror.com
# 若 embedding 与 chat 不同端点再填；留空则复用上面的 LLM_*
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# --- PostgreSQL（asyncpg=异步对话表；psycopg=同步向量写入）---
# 易错：驱动名写错（asyncpg/psycopg）或端口连到别的 agent 的库
DATABASE_URL=postgresql+asyncpg://rag:rag@127.0.0.1:5432/rag_agent
DATABASE_URL_SYNC=postgresql+psycopg://rag:rag@127.0.0.1:5432/rag_agent

# --- Redis（短期会话记忆，不是向量库）---
REDIS_URL=redis://127.0.0.1:6379/0
SESSION_TTL_SECONDS=3600

# --- RAG 切分与检索 ---
# chunk 太大：噪声多；太小：上下文碎。overlap 防止句子被切断丢语义
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=4
# pgvector 余弦「距离」：0=完全相同，越大越不相关
# 易错：阈值过严（如 0.2）→ 明明入库了却「知识库没有」；过松 → 答非所问
RAG_MAX_DISTANCE=0.55
COLLECTION_NAME=rag_docs
# PDF 上传字节上限（10MB）
MAX_PDF_BYTES=10485760
