##############################################################################
# spine-agent 环境变量模板
#
# 本 Agent 不使用 Postgres / Redis。工程文件写在 data/projects/。
# 端口 8004，避免和 rag(8001) / cs(8002) / finance(8003) 冲突。
# Windows 不要长期用 uv run：会锁住 .venv 里的 exe。
# 推荐：.\.venv\Scripts\python.exe -m uvicorn spine_agent.main:app --port 8004
##############################################################################

APP_NAME=spine-agent
APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8004

# 对话模型：把描述规划成部件 / 骨骼 / 关键帧。
LLM_API_KEY=sk-your-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=4096
LLM_TOP_P=1.0

# 文生图。密钥与 LLM_API_KEY 分开，改完要重启进程。
IMAGE_API_KEY=
IMAGE_BASE_URL=https://ws-3zvfybfuh8fwmo82.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
IMAGE_MODEL=qwen-image-2.1-turbo

# 可选。默认是项目下的 data/projects
# PROJECTS_DIR=D:\PJ\AI\Agent1\spine-agent\data\projects
