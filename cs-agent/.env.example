##############################################################################
# cs-agent（企业客服）环境变量模板
#
# 【目的】在 rag-agent 同构基础上，加「意图 + 连续未命中转人工」。
# 【易错点】
# 1. 端口与 rag 隔离：API=8002，PG=5433，Redis=6380 —— 抄错会连到 rag 的库。
# 2. 先 docker compose up -d，再起服务；否则 lifespan 里 Postgres ConnectionRefused。
# 3. Windows 勿长期用 `uv run cs-agent`：会锁 .venv 里的 exe，改代码难覆盖。
#    推荐：.\.venv\Scripts\python.exe -m uvicorn cs_agent.main:app --port 8002
##############################################################################

# --- App ---
APP_NAME=cs-agent
APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8002

# --- LLM ---
LLM_API_KEY=sk-your-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 客服场景温度略低，减少「发挥」
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TOP_P=1.0

# --- Embedding ---
# 与 rag-agent 相同策略；网关无 embedding 组 → local
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMS=512
HF_ENDPOINT=https://hf-mirror.com
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# --- PostgreSQL / Redis（本项目 docker-compose 端口，勿抄成 5432/6379）---
DATABASE_URL=postgresql+asyncpg://cs:cs@127.0.0.1:5433/cs_agent
DATABASE_URL_SYNC=postgresql+psycopg://cs:cs@127.0.0.1:5433/cs_agent
REDIS_URL=redis://127.0.0.1:6380/0
SESSION_TTL_SECONDS=3600

# --- RAG / FAQ ---
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=4
RAG_MAX_DISTANCE=0.55
COLLECTION_NAME=cs_faq
MAX_PDF_BYTES=10485760

# --- 客服策略 ---
# 同一会话连续 FAQ 未命中达到该次数 → 建议转人工
# 易错：设成 1 会过敏感；设太大用户会反复空答
ESCALATE_AFTER_MISSES=2
COMPANY_NAME=示例科技
