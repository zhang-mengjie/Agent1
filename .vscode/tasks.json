          "EMBEDDING_PROVIDER": "local",
          "EMBEDDING_MODEL": "BAAI/bge-small-zh-v1.5",
          "EMBEDDING_DIMS": "512",
          "HF_ENDPOINT": "https://hf-mirror.com",
          "API_PORT": "8002"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "cs-agent",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Application startup complete|Uvicorn running"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "agents",
        "clear": true
      }
    },
    {
      "label": "启动 finance-agent",
      "detail": "独立启动 · http://127.0.0.1:8003 （勿用 uv run）",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe -m uvicorn finance_agent.main:app --host 127.0.0.1 --port 8003 --reload --reload-dir src",
      "options": {
        "cwd": "${workspaceFolder}/finance-agent",
        "env": {
          "VIRTUAL_ENV": "",
          "PYTHONPATH": "src",
          "EMBEDDING_PROVIDER": "local",
          "EMBEDDING_MODEL": "BAAI/bge-small-zh-v1.5",
          "EMBEDDING_DIMS": "512",
          "HF_ENDPOINT": "https://hf-mirror.com",
          "API_PORT": "8003"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "finance-agent",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Application startup complete|Uvicorn running"
        }
      },
      "presentation": {
        "reveal": "always",
