{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "启动 rag-agent",
      "detail": "独立启动 · http://127.0.0.1:8001 （勿用 uv run）",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe -m uvicorn rag_agent.main:app --host 127.0.0.1 --port 8001 --reload --reload-dir src",
      "options": {
        "cwd": "${workspaceFolder}/rag-agent",
        "env": {
          "VIRTUAL_ENV": "",
          "PYTHONPATH": "src",
          "EMBEDDING_PROVIDER": "local",
          "EMBEDDING_MODEL": "BAAI/bge-small-zh-v1.5",
          "EMBEDDING_DIMS": "512",
          "HF_ENDPOINT": "https://hf-mirror.com",
          "API_PORT": "8001"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "rag-agent",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Application startup complete|Uvicorn running"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "agents",
        "clear": true
      }
    },
    {
      "label": "启动 cs-agent",
      "detail": "独立启动 · http://127.0.0.1:8002 （勿用 uv run）",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe -m uvicorn cs_agent.main:app --host 127.0.0.1 --port 8002 --reload --reload-dir src",
      "options": {
